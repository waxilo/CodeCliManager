{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeCliManager",
  "version": "0.1.63",
  "identifier": "com.codemanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CodeCliManager",
        "width": 896,
        "height": 560,
        "minWidth": 576,
        "minHeight": 360,
        "center": false,
        "visible": false,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5ODk2NEJDRDE4RThFQTQKUldTa2pvN1J2R1NKT1V0bTltQnRMSHNQempVdzFIdVN0Ym1Gd0d4aDBxdW1MVWJhRTVSVmlwNzEK",
      "dangerousInsecureTransportProtocol": true,
      "endpoints": [
        "http://127.0.0.1:47865/latest.json",
        "https://ghfast.top/https://github.com/waxilo/CodeCliManager/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/waxilo/CodeCliManager/releases/latest/download/latest.json",
        "https://github.com/waxilo/CodeCliManager/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
